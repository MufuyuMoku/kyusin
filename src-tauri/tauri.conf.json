{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KyuSin",
  "version": "0.1.0",
  "identifier": "com.mufuyumoku.kyusin",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "npm run build"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KyuSin",
        "width": 1120,
        "height": 740,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#050A05",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Game",
    "publisher": "MufuyuMoku",
    "shortDescription": "KyuSin",
    "longDescription": "KyuSin: kumpulan game papan, kartu, casino, dan arcade bergaya terminal retro. Berjalan lokal tanpa internet."
  }
}
